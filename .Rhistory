labels = function(x) gsub("^p__", "", gsub("p__Nematozoa", "p__Nematoda", x))) +
scale_fill_brewer(palette = "Set2",
labels = function(x) gsub("^p__", "", gsub("p__Nematozoa", "p__Nematoda", x))) +
scale_shape_manual(values = rep(16,5))
}
# Supplementary figure 2C,D
dd<-iNEXT_FullTableByAnthrop_ByGuild
plts_2<-list()
for(i in 1:length(dd)) {
plts_2[[i]]<-ggiNEXT(dd[[i]], type = 1,
facet.var = "Order.q", color.var = "Assemblage",
se = TRUE, grey = FALSE) +
xlab("Number of samples") + ylab("") +
facet_wrap(~Order.q, scales="free",
labeller = labeller(
Order.q = c("0" = "Richness","2" = "1/Simpson"))) +
theme(axis.text.x = element_text(size = 12),
axis.text.y = element_text(size = 12),
axis.title.x = element_text(size = 14),
strip.text = element_text(size = 14),
legend.text = element_text(size = 14)) +
guides(shape = "none", linetype = "none") +
scale_color_hue() +
scale_fill_hue() +
scale_shape_manual(values = rep(16,7))
}
# Supplementary figure 2 complete
sfig2 <- ggarrange(
ggarrange(plts_1[[2]],plts_1[[1]], ncol=2, common.legend = T, legend = "right"),
ggarrange(plts_2[[2]],plts_2[[1]], ncol=2, common.legend = T, legend = "right"),
nrow=2)
print(sfig2)
ggsave("Figures/Supplementary_Figure_2.pdf", plot = sfig2, device="pdf", scale=2,
width = 180, height = 148/210*180, units = "mm", bg="white")
arrPlts_s3a<-ggarrange(plotlist = plts_3a[6:7], ncol=1, nrow=2, common.legend=TRUE, legend = "bottom")
arrPlts_s3b<-ggarrange(plotlist = plts_3b[6:7], ncol=1, nrow=2, common.legend=TRUE, legend = "bottom")
arrPlts_s3c<-ggarrange(plotlist = plts_3c[6:7], ncol=1, nrow=2, common.legend=TRUE, legend = "bottom")
sfig3 <- ggarrange(arrPlts_s3a,arrPlts_s3b,arrPlts_s3c, ncol=3, legend = "bottom")
print(sfig3)
ggsave("Figures/Supplementary_Figure_3.pdf", plot = sfig3, device="pdf", scale=1.8,
width = 180, height = (2/7*297)/210*180, units = "mm", bg="white")
xx<-c("denoising-stats_A1.tsv", "denoising-stats_sdsd.tsv", "denoising-stats_1234.tsv")
sub("^[^_]+_([^\\.]+)\\.tsv$", "\\1", xx)
